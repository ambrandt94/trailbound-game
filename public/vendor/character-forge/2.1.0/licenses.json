{
 "rules": [
  {
   "match": "/^assets\\/models\\/.*\\.glb$/",
   "license": "Meshy paid plan (commercial use) + CF-authored edits",
   "status": "ok",
   "source": "Body meshes: bases generated with Meshy AI on Alex's paid Meshy plan (confirmed by Alex 2026-11-20, t282u), then remeshed, symmetrised, re-UVed, rigged and skinned by Character Forge (Blender scripts). Embedded Idle / Walk actions are CF-authored (bpy actions in races2..9 build_race*.py).",
   "note": "Paid-plan Meshy output: commercial use and inclusion in the game (public repo) cleared by the owner."
  },
  {
   "match": "/^assets\\/ears\\/.*\\.glb$/",
   "license": "Meshy paid plan (commercial use) + CF-authored",
   "status": "ok",
   "source": "Ear variants, Character Forge ear pipeline (symmetry/ears, ear_add.py); the default elf_long ear comes from the Meshy-derived rig (paid plan, t282u).",
   "note": ""
  },
  {
   "match": "/^assets\\/parts\\/.*\\.glb$/",
   "license": "CF-authored",
   "status": "ok",
   "source": "Snouts / horns / wings / noses built procedurally by Character Forge Blender scripts (races2..9 build_race*.py, noses1/2).",
   "note": "Generated geometry; palette textures CF-made."
  },
  {
   "match": "/^assets\\/clips\\/.*\\.json$/",
   "license": "CF-authored",
   "status": "ok",
   "source": "Walk exported from tiefling2260 (races3 build_race3.py procedural action).",
   "note": ""
  },
  {
   "match": "/^assets\\/packs\\/quaternius_anims\\.glb$/",
   "license": "CC0-1.0",
   "status": "ok",
   "source": "Quaternius, Universal Animation Library 1 (Standard), https://quaternius.com/packs/universalanimationlibrary.html",
   "note": "Optional (policy animationSet \"cf+cc0\"); retargeted to the CF rig."
  },
  {
   "match": "/^assets\\/packs\\/kaykit_anims\\.glb$/",
   "license": "CC0-1.0",
   "status": "ok",
   "source": "Kay Lousberg, KayKit Character Animations 1.1, https://kaylousberg.com/game-assets/character-animations",
   "note": "Optional; retargeted to the CF rig. Not wired by default."
  },
  {
   "match": "/^assets\\/shared\\/(hair|face|racepal|meta)\\.json$/",
   "license": "CF-authored",
   "status": "ok",
   "source": "Hair index texture + ramps (hair4), face sheet pixel art (face presets, brows1), race palette role maps, labels.",
   "note": "Role maps are painted on the UV layout of the Meshy-derived body; the pixels are CF-made."
  },
  {
   "match": "/^assets\\/wardrobe\\/.*\\.png$/",
   "license": "CF-authored",
   "status": "ok",
   "source": "Painted wardrobe index maps (wardrobe1 pipeline).",
   "note": ""
  },
  {
   "match": "/^(cf-runtime\\.mjs|chunks\\/.*\\.mjs)$/",
   "license": "CF code + MIT (three.js addons GLTFLoader, SkeletonUtils bundled in the engine chunk)",
   "status": "ok",
   "source": "Character Forge runtime; three.js examples/jsm addons (c) three.js authors, MIT.",
   "note": "three itself is a peer dependency, not bundled."
  }
 ],
